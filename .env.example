# Leave empty to run in mock mode. The server never sends this key to the browser.
OPENAI_API_KEY=

# Chat Completions model used when a key is present.
OPENAI_MODEL=gpt-4o-mini

# true forces the scripted mock even if a key is set.
# false requires OPENAI_API_KEY.
# Leave unset to use live mode only when a key is present.
MOCK_MODE=

# API port. The Vite dev server proxies /api to this port.
PORT=3001
